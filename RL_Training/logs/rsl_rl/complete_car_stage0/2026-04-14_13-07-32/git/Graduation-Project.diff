+                    value = value.to(self.device, dtype=torch.float32)
+                if value.ndim == 0:
+                    value = value.unsqueeze(0)
+                values.append(value.reshape(-1))
+            if values:
+                aggregated[key] = float(torch.mean(torch.cat(values)).item())
